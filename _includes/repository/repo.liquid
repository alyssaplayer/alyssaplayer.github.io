{% assign repo_parts = repository.repo | split: '/' %}
{% assign repo_owner = repo_parts[0] %}
{% assign repo_name = repo_parts[1] %}

<div class="repo-card p-3 m-2" style="
    width: 260px;
    border-radius: 0.75rem;
    border: 1px solid #e0e0e0;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  "
  onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 6px 16px rgba(0,0,0,0.12)';"
  onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 6px rgba(0,0,0,0.08)';">
  <a href="https://github.com/{{ repository.repo }}" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit;">
    <div style="display: flex; align-items: center; margin-bottom: 0.5rem;">
      <i class="fab fa-github" style="font-size: 1.2rem; margin-right: 0.5rem;"></i>
      <strong style="font-size: 1rem;">{{ repo_name }}</strong>
    </div>
    <div style="font-size: 0.8rem; color: #999; margin-bottom: 0.5rem;">
      {{ repo_owner }}
    </div>
    {% if repository.description %}
    <div style="font-size: 0.85rem; color: #555; line-height: 1.3;">
      {{ repository.description }}
    </div>
    {% endif %}
  </a>
</div>
